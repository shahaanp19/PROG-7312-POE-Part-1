@page "/sensors"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using SmartX.Shared.DTOs

@inject IHttpClientFactory HttpClientFactory

<div class="sx-page sx-sensor-page">

    <!-- SENSOR HERO -->
    <section class="sx-hero sx-sensor-hero">

        <div class="sx-hero-content">

            <div class="sx-eyebrow">
                <span class="sx-eyebrow-dot"></span>
                SMART-X / SENSOR MANAGEMENT
            </div>

            <h1>
                Sensor
                <span>Registration</span>
            </h1>

            <p class="sx-hero-description">
                Provision distributed IoT devices into the Smart-X gateway
                and associate each sensor with its physical deployment context.
            </p>

            <div class="sx-hero-meta">

                <div class="sx-status-pill">
                    <span class="sx-status-dot online"></span>
                    REGISTRATION GATEWAY
                </div>

                <span class="sx-divider"></span>

                <span class="sx-meta-text">
                    Device provisioning &amp; attachment management
                </span>

            </div>

        </div>

        <div class="sx-hero-visual sensor-visual" aria-hidden="true">
            <div class="sx-sensor-chip">
                <span>ESP32</span>
            </div>

            <div class="sx-sensor-ring ring-one"></div>
            <div class="sx-sensor-ring ring-two"></div>

            <span class="sx-data-node node-one"></span>
            <span class="sx-data-node node-two"></span>
            <span class="sx-data-node node-three"></span>
        </div>

    </section>


    <!-- REGISTRATION FORM -->
    <section class="sx-section">

        <div class="sx-section-heading">

            <div>
                <span class="sx-section-kicker">01 / DEVICE PROVISIONING</span>

                <h2>Register IoT Sensor</h2>

                <p>
                    Create a sensor profile containing its identity,
                    category, deployment location, and operational state.
                </p>
            </div>

            <div class="sx-step-indicator">
                <span class="active">01</span>
                <span>02</span>
                <span>03</span>
            </div>

        </div>


        <EditForm Model="@form"
                  OnValidSubmit="RegisterSensorAsync">

            <DataAnnotationsValidator />

            <div class="sx-validation-panel">
                <ValidationSummary />
            </div>


            <div class="sx-form-panel">

                <div class="sx-form-section-label">
                    DEVICE IDENTITY
                </div>

                <div class="sx-field">

                    <label for="name">
                        Sensor Name
                        <span class="required">*</span>
                    </label>

                    <InputText id="name"
                               class="sx-input"
                               @bind-Value="form.Name"
                               placeholder="e.g. Greenhouse Soil Sensor 01" />

                    <ValidationMessage For="@(() => form.Name)" />

                </div>


                <div class="sx-field">

                    <label for="deviceIdentifier">
                        Device MAC Address / Unique Identifier
                        <span class="required">*</span>
                    </label>

                    <InputText id="deviceIdentifier"
                               class="sx-input"
                               @bind-Value="form.DeviceIdentifier"
                               placeholder="e.g. AA:BB:CC:DD:EE:FF" />

                    <ValidationMessage For="@(() => form.DeviceIdentifier)" />

                    <span class="sx-field-help">
                        Use the physical device MAC address or another unique gateway identifier.
                    </span>

                </div>


                <div class="sx-form-section-label">
                    DEPLOYMENT CONFIGURATION
                </div>


                <div class="sx-field">

                    <label for="sensorType">
                        Sensor Category
                        <span class="required">*</span>
                    </label>

                    <InputSelect id="sensorType"
                                 class="sx-input"
                                 @bind-Value="form.SensorType">

                        <option value="">
                            Select sensor category
                        </option>

                        <option value="Environmental">
                            Environmental
                        </option>

                        <option value="Power Consumption">
                            Power Consumption
                        </option>

                        <option value="Actuator">
                            Actuator
                        </option>

                    </InputSelect>

                    <ValidationMessage For="@(() => form.SensorType)" />

                </div>


                <div class="sx-field">

                    <label for="location">
                        Deployment Location
                        <span class="required">*</span>
                    </label>

                    <InputText id="location"
                               class="sx-input"
                               @bind-Value="form.Location"
                               placeholder="e.g. Facility A / Zone 1 / Node B" />

                    <ValidationMessage For="@(() => form.Location)" />

                    <span class="sx-field-help">
                        Identify the physical room, zone, node, or deployment area.
                    </span>

                </div>


                <div class="sx-field sx-field-wide">

                    <label for="description">
                        Description
                    </label>

                    <InputTextArea id="description"
                                   class="sx-input sx-textarea"
                                   @bind-Value="form.Description"
                                   placeholder="Describe the device, purpose, deployment context, or hardware configuration..." />

                    <ValidationMessage For="@(() => form.Description)" />

                </div>


                <div class="sx-active-toggle">

                    <InputCheckbox id="sensorActive"
                                   @bind-Value="form.IsActive" />

                    <label for="sensorActive">

                        <strong>
                            Activate sensor immediately
                        </strong>

                        <span>
                            The sensor will be registered as operational
                            and available to the Smart-X gateway.
                        </span>

                    </label>

                </div>


                <div class="sx-form-actions">

                    <button type="submit"
                            class="sx-button sx-button-primary"
                            disabled="@isSubmitting">

                        @(isSubmitting
                            ? "Registering Sensor..."
                            : "Register Sensor")

                    </button>

                    <button type="button"
                            class="sx-button sx-button-secondary"
                            @onclick="ClearForm"
                            disabled="@isSubmitting">

                        Clear Form

                    </button>

                </div>

            </div>

        </EditForm>


        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="sx-feedback @(registeredSensor is not null ? "success" : "error")"
                 role="status"
                 aria-live="polite">

                <span class="sx-feedback-icon">
                    @(registeredSensor is not null ? "✓" : "!")
                </span>

                <span>@statusMessage</span>

            </div>
        }

    </section>


    <!-- REGISTERED SENSOR -->
    @if (registeredSensor is not null)
    {
        <section class="sx-section">

            <div class="sx-success-banner">

                <div class="sx-success-icon">
                    ✓
                </div>

                <div>
                    <span class="sx-section-kicker">REGISTRATION COMPLETE</span>
                    <h2>Sensor successfully provisioned</h2>
                    <p>
                        The Smart-X gateway has accepted the sensor registration.
                    </p>
                </div>

            </div>


            <div class="sx-sensor-profile">

                <div class="sx-profile-header">

                    <div class="sx-profile-icon">
                        SX
                    </div>

                    <div>
                        <span class="sx-card-kicker">SENSOR PROFILE</span>

                        <h3>
                            @registeredSensor.Name
                        </h3>

                        <span class="sx-profile-id">
                            @registeredSensor.SensorId
                        </span>
                    </div>

                </div>


                <div class="sx-profile-grid">

                    <div class="sx-profile-item">
                        <span>DEVICE IDENTIFIER</span>
                        <strong>@registeredSensor.DeviceIdentifier</strong>
                    </div>

                    <div class="sx-profile-item">
                        <span>SENSOR CATEGORY</span>
                        <strong>@registeredSensor.SensorType</strong>
                    </div>

                    <div class="sx-profile-item">
                        <span>DEPLOYMENT LOCATION</span>
                        <strong>@registeredSensor.Location</strong>
                    </div>

                    <div class="sx-profile-item">
                        <span>REGISTERED</span>
                        <strong>@registeredSensor.RegisteredAtUtc</strong>
                    </div>

                </div>

            </div>


            <!-- ATTACHMENTS -->
            <section class="sx-attachment-section">

                <div class="sx-section-heading">

                    <div>
                        <span class="sx-section-kicker">02 / HARDWARE EVIDENCE</span>

                        <h2>Sensor Attachments</h2>

                        <p>
                            Attach configuration files, deployment photographs,
                            hardware logs, or other supporting evidence directly
                            to this sensor profile.
                        </p>
                    </div>

                    <div class="sx-security-badge">
                        <span>✓</span>
                        SECURE UPLOAD
                    </div>

                </div>


                <div class="sx-upload-panel">

                    <div class="sx-upload-header">
                        <div class="sx-upload-icon">
                            ↑
                        </div>

                        <div>
                            <strong>
                                Upload device evidence
                            </strong>

                            <span>
                                Maximum file size: 10 MB
                            </span>
                        </div>
                    </div>


                    <div class="sx-field">

                        <label for="attachmentType">
                            Attachment Type
                        </label>

                        <InputSelect id="attachmentType"
                                     class="sx-input"
                                     @bind-Value="attachmentType"
                                     disabled="@isUploading">

                            <option value="Configuration">
                                Device Configuration
                            </option>

                            <option value="Photo">
                                Deployment Photo
                            </option>

                            <option value="Log">
                                Hardware Log
                            </option>

                            <option value="Other">
                                Other
                            </option>

                        </InputSelect>

                    </div>


                    <div class="sx-file-drop">

                        <InputFile id="attachment"
                                   OnChange="HandleFileSelected"
                                   accept=".jpg,.jpeg,.png,.txt,.log,.json,.xml,.csv,.pdf"
                                   disabled="@isUploading" />

                        <label for="attachment">

                            <span class="sx-file-icon">
                                +
                            </span>

                            <strong>
                                Select a file
                            </strong>

                            <span>
                                JPG, PNG, TXT, LOG, JSON, XML, CSV or PDF
                            </span>

                        </label>

                    </div>


                    @if (selectedFile is not null)
                    {
                        <div class="sx-selected-file">

                            <div class="sx-file-preview-icon">
                                FILE
                            </div>

                            <div class="sx-selected-file-info">

                                <strong>
                                    @selectedFile.Name
                                </strong>

                                <span>
                                    @FormatFileSize(selectedFile.Size)
                                    ·
                                    @(string.IsNullOrWhiteSpace(
                                        selectedFile.ContentType)
                                        ? "Unknown type"
                                        : selectedFile.ContentType)
                                </span>

                            </div>

                            <span class="sx-ready-badge">
                                READY
                            </span>

                        </div>
                    }


                    <div class="sx-upload-actions">

                        <button type="button"
                                class="sx-button sx-button-primary"
                                @onclick="UploadAttachmentAsync"
                                disabled="@(selectedFile is null || isUploading)">

                            @(isUploading
                                ? "Uploading securely..."
                                : "Upload Attachment")

                        </button>

                    </div>


                    @if (isUploading)
                    {
                        <div class="sx-upload-progress"
                             role="status"
                             aria-live="polite">

                            <div class="sx-spinner"></div>

                            <div>
                                <strong>Upload in progress</strong>
                                <span>Securely transferring attachment to the gateway...</span>
                            </div>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(uploadMessage))
                    {
                        <div class="sx-feedback @(uploadedAttachment is not null ? "success" : "error")"
                             role="status"
                             aria-live="polite">

                            <span class="sx-feedback-icon">
                                @(uploadedAttachment is not null ? "✓" : "!")
                            </span>

                            <span>@uploadMessage</span>

                        </div>
                    }


                    @if (uploadedAttachment is not null)
                    {
                        <div class="sx-uploaded-card">

                            <div class="sx-uploaded-check">
                                ✓
                            </div>

                            <div class="sx-uploaded-info">

                                <span class="sx-card-kicker">
                                    ATTACHMENT STORED
                                </span>

                                <h3>
                                    @uploadedAttachment.OriginalFileName
                                </h3>

                                <div class="sx-uploaded-details">

                                    <span>
                                        <strong>Type:</strong>
                                        @uploadedAttachment.AttachmentType
                                    </span>

                                    <span>
                                        <strong>Size:</strong>
                                        @FormatFileSize(
                                            uploadedAttachment.FileSizeBytes)
                                    </span>

                                    <span>
                                        <strong>Uploaded:</strong>
                                        @uploadedAttachment.UploadedAtUtc
                                    </span>

                                </div>

                                @if (uploadedAttachment.IsEncrypted)
                                {
                                    <span class="sx-encryption-badge">
                                        ✓ Encrypted
                                        @uploadedAttachment.EncryptionAlgorithm
                                    </span>
                                }

                            </div>

                        </div>
                    }

                </div>

            </section>

        </section>
    }

</div>


@code {

    private const long MaximumFileSize =
        10 * 1024 * 1024;

    private static readonly HashSet<string>
        AllowedExtensions =
            new(StringComparer.OrdinalIgnoreCase)
            {
                ".jpg",
                ".jpeg",
                ".png",
                ".txt",
                ".log",
                ".json",
                ".xml",
                ".csv",
                ".pdf"
            };

    private SensorFormModel form = new();

    private SensorRegistrationResponse?
        registeredSensor;

    private bool isSubmitting;

    private string? statusMessage;

    private IBrowserFile? selectedFile;

    private bool isUploading;

    private string attachmentType =
        "Configuration";

    private string? uploadMessage;

    private SensorAttachmentResponse?
        uploadedAttachment;

    private async Task RegisterSensorAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        statusMessage = null;
        registeredSensor = null;

        try
        {
            var client =
                HttpClientFactory.CreateClient(
                    "SmartXApi");

            var request =
                new SensorRegistrationRequest
                {
                    Name = form.Name.Trim(),

                    DeviceIdentifier =
                        form.DeviceIdentifier.Trim(),

                    SensorType =
                        form.SensorType.Trim(),

                    Location =
                        form.Location.Trim(),

                    Description =
                        form.Description.Trim(),

                    IsActive =
                        form.IsActive
                };

            var response =
                await client.PostAsJsonAsync(
                    "api/sensor-registration",
                    request);

            if (response.IsSuccessStatusCode)
            {
                registeredSensor =
                    await response.Content
                        .ReadFromJsonAsync<
                            SensorRegistrationResponse>();

                statusMessage =
                    registeredSensor is null
                        ? "Sensor registration completed, but the API returned no sensor details."
                        : "Sensor registered successfully.";

                form = new SensorFormModel();
            }
            else
            {
                var error =
                    await response.Content
                        .ReadAsStringAsync();

                statusMessage =
                    string.IsNullOrWhiteSpace(error)
                        ? $"Registration failed. HTTP {(int)response.StatusCode}."
                        : $"Registration failed. HTTP {(int)response.StatusCode}. {error}";
            }
        }
        catch (HttpRequestException)
        {
            statusMessage =
                "Unable to connect to the Smart-X API.";
        }
        catch (TaskCanceledException)
        {
            statusMessage =
                "The registration request timed out.";
        }
        catch (Exception ex)
        {
            statusMessage =
                $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void HandleFileSelected(
        InputFileChangeEventArgs e)
    {
        selectedFile = null;
        uploadedAttachment = null;
        uploadMessage = null;

        var file = e.File;

        if (file is null)
        {
            uploadMessage =
                "Please select a file.";
            return;
        }

        if (file.Size <= 0)
        {
            uploadMessage =
                "The selected file is empty.";
            return;
        }

        if (file.Size > MaximumFileSize)
        {
            uploadMessage =
                "The selected file exceeds the 10 MB limit.";
            return;
        }

        var extension =
            Path.GetExtension(file.Name);

        if (!AllowedExtensions.Contains(extension))
        {
            uploadMessage =
                $"File type '{extension}' is not supported.";
            return;
        }

        selectedFile = file;

        uploadMessage =
            "File selected and ready for secure upload.";
    }

    private async Task UploadAttachmentAsync()
    {
        if (selectedFile is null ||
            registeredSensor is null ||
            isUploading)
        {
            return;
        }

        isUploading = true;
        uploadMessage = null;
        uploadedAttachment = null;

        try
        {
            if (selectedFile.Size <= 0)
            {
                uploadMessage =
                    "The selected file is empty.";
                return;
            }

            if (selectedFile.Size > MaximumFileSize)
            {
                uploadMessage =
                    "The selected file exceeds the 10 MB limit.";
                return;
            }

            var extension =
                Path.GetExtension(selectedFile.Name);

            if (!AllowedExtensions.Contains(extension))
            {
                uploadMessage =
                    $"File type '{extension}' is not supported.";
                return;
            }

            using var content =
                new MultipartFormDataContent();

            await using var stream =
                selectedFile.OpenReadStream(
                    maxAllowedSize:
                        MaximumFileSize);

            using var streamContent =
                new StreamContent(stream);

            streamContent.Headers.ContentType =
                new System.Net.Http.Headers
                    .MediaTypeHeaderValue(
                        string.IsNullOrWhiteSpace(
                            selectedFile.ContentType)
                            ? "application/octet-stream"
                            : selectedFile.ContentType);

            content.Add(
                streamContent,
                "file",
                selectedFile.Name);

            content.Add(
                new StringContent(attachmentType),
                "attachmentType");

            var client =
                HttpClientFactory.CreateClient(
                    "SmartXApi");

            var response =
                await client.PostAsync(
                    $"api/sensor-attachments/{registeredSensor.SensorId}",
                    content);

            if (response.IsSuccessStatusCode)
            {
                uploadedAttachment =
                    await response.Content
                        .ReadFromJsonAsync<
                            SensorAttachmentResponse>();

                uploadMessage =
                    uploadedAttachment is null
                        ? "Upload completed, but no attachment details were returned."
                        : "Attachment uploaded and encrypted successfully.";

                selectedFile = null;
            }
            else
            {
                var error =
                    await response.Content
                        .ReadAsStringAsync();

                uploadMessage =
                    string.IsNullOrWhiteSpace(error)
                        ? $"Upload failed. HTTP {(int)response.StatusCode}."
                        : $"Upload failed. HTTP {(int)response.StatusCode}. {error}";
            }
        }
        catch (IOException)
        {
            uploadMessage =
                "The selected file could not be read.";
        }
        catch (HttpRequestException)
        {
            uploadMessage =
                "Unable to connect to the Smart-X API.";
        }
        catch (TaskCanceledException)
        {
            uploadMessage =
                "The upload request timed out.";
        }
        catch (Exception ex)
        {
            uploadMessage =
                $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private void ClearForm()
    {
        form = new SensorFormModel();

        registeredSensor = null;
        statusMessage = null;
        selectedFile = null;
        uploadMessage = null;
        uploadedAttachment = null;
        attachmentType = "Configuration";
    }

    private static string FormatFileSize(
        long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024d:F1} KB";
        }

        return $"{bytes / (1024d * 1024d):F2} MB";
    }

    private sealed class SensorFormModel
    {
        [Required(
            ErrorMessage =
                "Sensor name is required.")]
        [StringLength(
            100,
            MinimumLength = 2,
            ErrorMessage =
                "Sensor name must be between 2 and 100 characters.")]
        public string Name { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage =
                "Device identifier is required.")]
        [StringLength(
            100,
            MinimumLength = 2,
            ErrorMessage =
                "Device identifier must be between 2 and 100 characters.")]
        public string DeviceIdentifier { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage =
                "Sensor category is required.")]
        [RegularExpression(
            "^(Environmental|Power Consumption|Actuator)$",
            ErrorMessage =
                "Please select a valid sensor category.")]
        public string SensorType { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage =
                "Deployment location is required.")]
        [StringLength(
            100,
            MinimumLength = 2,
            ErrorMessage =
                "Deployment location must be between 2 and 100 characters.")]
        public string Location { get; set; } =
            string.Empty;

        [StringLength(500)]
        public string Description { get; set; } =
            string.Empty;

        public bool IsActive { get; set; } = true;
    }
}
