@page "/sensors"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using SmartX.Shared.DTOs

@inject IHttpClientFactory HttpClientFactory

<h1>Sensor Registration</h1>

<EditForm Model="@form" OnValidSubmit="RegisterSensorAsync">
    <DataAnnotationsValidator />

    <div>
        <label for="name">Sensor Name</label>
        <InputText id="name"
                   @bind-Value="form.Name" />
        <ValidationMessage For="@(() => form.Name)" />
    </div>

    <div>
        <label for="deviceIdentifier">
            Device MAC Address / Unique Identifier
        </label>

        <InputText id="deviceIdentifier"
                   @bind-Value="form.DeviceIdentifier" />

        <ValidationMessage For="@(() => form.DeviceIdentifier)" />
    </div>

    <div>
        <label for="sensorType">Sensor Category</label>

        <InputSelect id="sensorType"
                     @bind-Value="form.SensorType">

            <option value="">-- Select category --</option>
            <option value="Environmental">Environmental</option>
            <option value="Power Consumption">
                Power Consumption
            </option>
            <option value="Actuator">Actuator</option>

        </InputSelect>

        <ValidationMessage For="@(() => form.SensorType)" />
    </div>

    <div>
        <label for="location">Deployment Location</label>

        <InputText id="location"
                   @bind-Value="form.Location" />

        <ValidationMessage For="@(() => form.Location)" />
    </div>

    <div>
        <label for="description">Description</label>

        <InputTextArea id="description"
                       @bind-Value="form.Description" />

        <ValidationMessage For="@(() => form.Description)" />
    </div>

    <div>
        <label>
            <InputCheckbox @bind-Value="form.IsActive" />
            Sensor is active
        </label>
    </div>

    <button type="submit"
            disabled="@isSubmitting">

        @(isSubmitting
            ? "Registering..."
            : "Register Sensor")
    </button>

    <button type="button"
            @onclick="ClearForm"
            disabled="@isSubmitting">

        Clear
    </button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <p>@statusMessage</p>
}

@if (registeredSensor is not null)
{
    <hr />

    <h2>Sensor Registered Successfully</h2>

    <p>
        <strong>Sensor ID:</strong>
        @registeredSensor.SensorId
    </p>

    <p>
        <strong>Name:</strong>
        @registeredSensor.Name
    </p>

    <p>
        <strong>Device Identifier:</strong>
        @registeredSensor.DeviceIdentifier
    </p>

    <p>
        <strong>Sensor Type:</strong>
        @registeredSensor.SensorType
    </p>

    <p>
        <strong>Location:</strong>
        @registeredSensor.Location
    </p>

    <p>
        <strong>Registered:</strong>
        @registeredSensor.RegisteredAtUtc
    </p>

    <hr />

    <section aria-labelledby="attachments-heading">

        <h2 id="attachments-heading">
            Sensor Attachments
        </h2>

        <p>
            Attach a device configuration file,
            deployment photo, or hardware log to this sensor.
        </p>

        <div>
            <label for="attachmentType">
                Attachment Type
            </label>

            <InputSelect id="attachmentType"
                         @bind-Value="attachmentType"
                         disabled="@isUploading">

                <option value="Configuration">
                    Device Configuration
                </option>

                <option value="Photo">
                    Deployment Photo
                </option>

                <option value="Log">
                    Hardware Log
                </option>

                <option value="Other">
                    Other
                </option>

            </InputSelect>
        </div>

        <div>
            <label for="attachment">
                Select File
            </label>

            <InputFile id="attachment"
                       OnChange="HandleFileSelected"
                       accept=".jpg,.jpeg,.png,.txt,.log,.json,.xml,.csv,.pdf"
                       disabled="@isUploading" />
        </div>

        @if (selectedFile is not null)
        {
            <div>
                <p>
                    <strong>Selected file:</strong>
                    @selectedFile.Name
                </p>

                <p>
                    <strong>Size:</strong>
                    @FormatFileSize(selectedFile.Size)
                </p>

                <p>
                    <strong>Type:</strong>
                    @(string.IsNullOrWhiteSpace(selectedFile.ContentType)
                        ? "Unknown"
                        : selectedFile.ContentType)
                </p>

                <p>
                    <strong>Status:</strong>
                    Ready for secure upload.
                </p>
            </div>
        }

        <button type="button"
                @onclick="UploadAttachmentAsync"
                disabled="@(selectedFile is null || isUploading)">

            @(isUploading
                ? "Uploading securely..."
                : "Upload Attachment")
        </button>

        @if (isUploading)
        {
            <p role="status">
                Upload in progress. Please wait...
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(uploadMessage))
        {
            <p role="status">
                @uploadMessage
            </p>
        }

        @if (uploadedAttachment is not null)
        {
            <div>

                <h3>Attachment Uploaded Successfully</h3>

                <p>
                    <strong>File:</strong>
                    @uploadedAttachment.OriginalFileName
                </p>

                <p>
                    <strong>Attachment type:</strong>
                    @uploadedAttachment.AttachmentType
                </p>

                <p>
                    <strong>Size:</strong>
                    @FormatFileSize(
                        uploadedAttachment.FileSizeBytes)
                </p>

                <p>
                    <strong>Uploaded:</strong>
                    @uploadedAttachment.UploadedAtUtc
                </p>

                @if (uploadedAttachment.IsEncrypted)
                {
                    <p>
                        <strong>Encryption:</strong>
                        @uploadedAttachment.EncryptionAlgorithm
                    </p>
                }

            </div>
        }

    </section>
}

@code {

    private const long MaximumFileSize =
        10 * 1024 * 1024;

    private static readonly HashSet<string> AllowedExtensions =
        new(StringComparer.OrdinalIgnoreCase)
        {
            ".jpg",
            ".jpeg",
            ".png",
            ".txt",
            ".log",
            ".json",
            ".xml",
            ".csv",
            ".pdf"
        };

    private SensorFormModel form = new();

    private SensorRegistrationResponse? registeredSensor;

    private bool isSubmitting;

    private string? statusMessage;

    private IBrowserFile? selectedFile;

    private bool isUploading;

    private string attachmentType = "Configuration";

    private string? uploadMessage;

    private SensorAttachmentResponse? uploadedAttachment;

    private async Task RegisterSensorAsync()
    {
        isSubmitting = true;
        statusMessage = null;
        registeredSensor = null;

        try
        {
            var client =
                HttpClientFactory.CreateClient("SmartXApi");

            var request =
                new SensorRegistrationRequest
                {
                    Name = form.Name.Trim(),

                    DeviceIdentifier =
                        form.DeviceIdentifier.Trim(),

                    SensorType =
                        form.SensorType.Trim(),

                    Location =
                        form.Location.Trim(),

                    Description =
                        form.Description.Trim(),

                    IsActive =
                        form.IsActive
                };

            var response =
                await client.PostAsJsonAsync(
                    "api/sensor-registration",
                    request);

            if (response.IsSuccessStatusCode)
            {
                registeredSensor =
                    await response.Content
                        .ReadFromJsonAsync<SensorRegistrationResponse>();

                statusMessage =
                    "Sensor registered successfully.";

                form = new SensorFormModel();
            }
            else
            {
                statusMessage =
                    $"Registration failed. HTTP {(int)response.StatusCode}.";
            }
        }
        catch (HttpRequestException ex)
        {
            statusMessage =
                $"Unable to connect to the Smart-X API: {ex.Message}";
        }
        catch (Exception ex)
        {
            statusMessage =
                $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void HandleFileSelected(
        InputFileChangeEventArgs e)
    {
        selectedFile = null;
        uploadedAttachment = null;
        uploadMessage = null;

        var file = e.File;

        if (file is null)
        {
            uploadMessage =
                "Please select a file.";

            return;
        }

        if (file.Size <= 0)
        {
            uploadMessage =
                "The selected file is empty.";

            return;
        }

        if (file.Size > MaximumFileSize)
        {
            uploadMessage =
                "The selected file exceeds the 10 MB limit.";

            return;
        }

        var extension =
            Path.GetExtension(file.Name);

        if (!AllowedExtensions.Contains(extension))
        {
            uploadMessage =
                $"File type '{extension}' is not supported.";

            return;
        }

        selectedFile = file;

        uploadMessage =
            "File selected and ready for secure upload.";
    }

    private async Task UploadAttachmentAsync()
    {
        if (selectedFile is null ||
            registeredSensor is null ||
            isUploading)
        {
            return;
        }

        isUploading = true;
        uploadMessage = null;
        uploadedAttachment = null;

        try
        {
            if (selectedFile.Size <= 0)
            {
                uploadMessage =
                    "The selected file is empty.";

                return;
            }

            if (selectedFile.Size > MaximumFileSize)
            {
                uploadMessage =
                    "The selected file exceeds the 10 MB limit.";

                return;
            }

            var extension =
                Path.GetExtension(selectedFile.Name);

            if (!AllowedExtensions.Contains(extension))
            {
                uploadMessage =
                    $"File type '{extension}' is not supported.";

                return;
            }

            using var content =
                new MultipartFormDataContent();

            await using var stream =
                selectedFile.OpenReadStream(
                    maxAllowedSize: MaximumFileSize);

            using var streamContent =
                new StreamContent(stream);

            streamContent.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue(
                    string.IsNullOrWhiteSpace(
                        selectedFile.ContentType)
                        ? "application/octet-stream"
                        : selectedFile.ContentType);

            content.Add(
                streamContent,
                "file",
                selectedFile.Name);

            content.Add(
                new StringContent(attachmentType),
                "attachmentType");

            var client =
                HttpClientFactory.CreateClient("SmartXApi");

            var response =
                await client.PostAsync(
                    $"api/sensor-attachments/{registeredSensor.SensorId}",
                    content);

            if (response.IsSuccessStatusCode)
            {
                uploadedAttachment =
                    await response.Content
                        .ReadFromJsonAsync<SensorAttachmentResponse>();

                uploadMessage =
                    "Attachment uploaded and encrypted successfully.";

                selectedFile = null;
            }
            else
            {
                var error =
                    await response.Content
                        .ReadAsStringAsync();

                uploadMessage =
                    $"Upload failed. HTTP {(int)response.StatusCode}. {error}";
            }
        }
        catch (IOException ex)
        {
            uploadMessage =
                $"File could not be read: {ex.Message}";
        }
        catch (HttpRequestException ex)
        {
            uploadMessage =
                $"Unable to connect to the Smart-X API: {ex.Message}";
        }
        catch (Exception ex)
        {
            uploadMessage =
                $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private void ClearForm()
    {
        form = new SensorFormModel();

        registeredSensor = null;

        statusMessage = null;

        selectedFile = null;

        uploadMessage = null;

        uploadedAttachment = null;

        attachmentType = "Configuration";
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024d:F1} KB";
        }

        return $"{bytes / (1024d * 1024d):F2} MB";
    }

    private sealed class SensorFormModel
    {
        [Required(
            ErrorMessage = "Sensor name is required.")]
        [StringLength(100)]
        public string Name { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage = "Device identifier is required.")]
        [StringLength(100)]
        public string DeviceIdentifier { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage = "Sensor category is required.")]
        public string SensorType { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage = "Deployment location is required.")]
        [StringLength(100)]
        public string Location { get; set; } =
            string.Empty;

        [StringLength(500)]
        public string Description { get; set; } =
            string.Empty;

        public bool IsActive { get; set; } = true;
    }
}