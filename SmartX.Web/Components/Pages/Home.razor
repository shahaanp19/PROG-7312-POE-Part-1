@page "/"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using SmartX.Shared.Models

@inject IHttpClientFactory HttpClientFactory
@implements IDisposable

<div class="sx-page">

    <!-- HERO -->
    <section class="sx-hero">
        <div class="sx-hero-content">

            <div class="sx-eyebrow">
                <span class="sx-eyebrow-dot"></span>
                SMART-X / EDGE OPERATIONS
            </div>

            <h1>
                Data Ingestion
                <span>Gateway</span>
            </h1>

            <p class="sx-hero-description">
                Centralised telemetry monitoring, sensor management,
                and intelligent incident prioritisation for distributed
                IoT environments.
            </p>

            <div class="sx-hero-meta">
                <div class="sx-status-pill">
                    <span class="sx-status-dot @(GatewayOnline ? "online" : "offline")"></span>
                    <span>@GatewayStatus</span>
                </div>

                <span class="sx-divider"></span>

                <span class="sx-meta-text">
                    Edge Gateway Interface
                </span>
            </div>

        </div>

        <div class="sx-hero-visual" aria-hidden="true">
            <div class="sx-orbit sx-orbit-one"></div>
            <div class="sx-orbit sx-orbit-two"></div>
            <div class="sx-core">
                <span>SX</span>
            </div>
            <div class="sx-signal sx-signal-one"></div>
            <div class="sx-signal sx-signal-two"></div>
            <div class="sx-signal sx-signal-three"></div>
        </div>
    </section>


    <!-- GATEWAY CONTROL -->
    <section class="sx-control-panel">

        <div class="sx-section-heading">
            <div>
                <span class="sx-section-kicker">01 / SYSTEM STATUS</span>
                <h2>Gateway Control Centre</h2>
                <p>
                    Monitor the connection between the Smart-X client
                    interface and the ingestion API.
                </p>
            </div>

            <button class="sx-button sx-button-primary"
                    @onclick="CheckGatewayAsync"
                    disabled="@IsChecking">

                <span class="sx-button-icon">
                    ↻
                </span>

                @(IsChecking
                    ? "Checking Gateway..."
                    : "Refresh Gateway")

            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(ConnectionMessage))
        {
            <div class="sx-feedback @(GatewayOnline ? "success" : "error")"
                 role="status"
                 aria-live="polite">

                <span class="sx-feedback-icon">
                    @(GatewayOnline ? "✓" : "!")
                </span>

                <span>@ConnectionMessage</span>

            </div>
        }

    </section>


    <!-- ENGAGEMENT CENTRE -->
    <section class="sx-section">

        <div class="sx-section-heading">
            <div>
                <span class="sx-section-kicker">02 / INTELLIGENT MONITORING</span>
                <h2>Incident Engagement Centre</h2>
                <p>
                    Dynamic attention management prioritises operational
                    incidents according to severity and current system state.
                </p>
            </div>

            <div class="sx-live-label">
                <span></span>
                LIVE MONITORING
            </div>
        </div>

        @if (IsLoadingEngagement && EngagementSnapshot is null)
        {
            <div class="sx-loading-card">
                <div class="sx-spinner"></div>
                <div>
                    <strong>Loading engagement intelligence</strong>
                    <span>Retrieving current gateway incident state...</span>
                </div>
            </div>
        }
        else if (EngagementSnapshot is not null)
        {
            <div class="sx-attention-card">

                <div>
                    <span class="sx-card-kicker">CURRENT ATTENTION LEVEL</span>

                    <strong class="sx-attention-value">
                        @EngagementSnapshot.AttentionLevel
                    </strong>

                    <span class="sx-card-subtext">
                        Engagement snapshot generated
                        @EngagementSnapshot.GeneratedAtUtc.ToLocalTime()
                    </span>
                </div>

                <div class="sx-attention-indicator">
                    <span></span>
                </div>

            </div>


            <!-- KPI GRID -->
            <div class="sx-kpi-grid">

                <article class="sx-kpi-card">
                    <span class="sx-kpi-label">TOTAL ISSUES</span>
                    <strong>@EngagementSnapshot.TotalIssues</strong>
                    <span class="sx-kpi-description">All recorded incidents</span>
                </article>

                <article class="sx-kpi-card">
                    <span class="sx-kpi-label">OPEN</span>
                    <strong>@EngagementSnapshot.OpenIssues</strong>
                    <span class="sx-kpi-description">Currently requiring monitoring</span>
                </article>

                <article class="sx-kpi-card sx-kpi-critical">
                    <span class="sx-kpi-label">CRITICAL</span>
                    <strong>@EngagementSnapshot.CriticalOpenIssues</strong>
                    <span class="sx-kpi-description">Immediate attention required</span>
                </article>

                <article class="sx-kpi-card sx-kpi-warning">
                    <span class="sx-kpi-label">WARNINGS</span>
                    <strong>@EngagementSnapshot.WarningOpenIssues</strong>
                    <span class="sx-kpi-description">Under active observation</span>
                </article>

                <article class="sx-kpi-card">
                    <span class="sx-kpi-label">INFORMATION</span>
                    <strong>@EngagementSnapshot.InformationalOpenIssues</strong>
                    <span class="sx-kpi-description">Informational events</span>
                </article>

                <article class="sx-kpi-card sx-kpi-resolved">
                    <span class="sx-kpi-label">RESOLVED</span>
                    <strong>@EngagementSnapshot.ResolvedIssues</strong>
                    <span class="sx-kpi-description">Successfully closed incidents</span>
                </article>

            </div>


            <!-- ATTENTION SIGNAL -->
            @if (EngagementSnapshot.CriticalOpenIssues > 0)
            {
                <div class="sx-alert sx-alert-critical">

                    <div class="sx-alert-icon">!</div>

                    <div>
                        <strong>Immediate attention required</strong>

                        <p>
                            @EngagementSnapshot.CriticalOpenIssues
                            critical
                            @(EngagementSnapshot.CriticalOpenIssues == 1
                                ? "incident requires"
                                : "incidents require")
                            immediate attention.
                        </p>
                    </div>

                </div>
            }
            else if (EngagementSnapshot.WarningOpenIssues > 0)
            {
                <div class="sx-alert sx-alert-warning">

                    <div class="sx-alert-icon">!</div>

                    <div>
                        <strong>Attention required</strong>

                        <p>
                            @EngagementSnapshot.WarningOpenIssues
                            warning
                            @(EngagementSnapshot.WarningOpenIssues == 1
                                ? "incident remains"
                                : "incidents remain")
                            under observation.
                        </p>
                    </div>

                </div>
            }
            else if (EngagementSnapshot.OpenIssues > 0)
            {
                <div class="sx-alert sx-alert-info">

                    <div class="sx-alert-icon">i</div>

                    <div>
                        <strong>Monitoring active</strong>

                        <p>
                            @EngagementSnapshot.OpenIssues
                            open
                            @(EngagementSnapshot.OpenIssues == 1
                                ? "incident is"
                                : "incidents are")
                            currently being monitored.
                        </p>
                    </div>

                </div>
            }
            else
            {
                <div class="sx-alert sx-alert-success">

                    <div class="sx-alert-icon">✓</div>

                    <div>
                        <strong>All systems clear</strong>

                        <p>
                            No active incidents currently require attention.
                        </p>
                    </div>

                </div>
            }

        }

    </section>


    <!-- PRIORITY QUEUE -->
    @if (EngagementSnapshot is not null)
    {
        <section class="sx-section">

            <div class="sx-section-heading">
                <div>
                    <span class="sx-section-kicker">03 / PRIORITY ENGINE</span>
                    <h2>Priority Attention Queue</h2>
                    <p>
                        Highest-risk incidents are surfaced first to reduce
                        investigation time and improve operational response.
                    </p>
                </div>
            </div>

            @if (!EngagementSnapshot.PriorityIssues.Any())
            {
                <div class="sx-empty-state">
                    <div class="sx-empty-icon">✓</div>
                    <strong>No active incidents</strong>
                    <span>The priority queue is currently clear.</span>
                </div>
            }
            else
            {
                <div class="sx-issue-grid">

                    @foreach (var issue in EngagementSnapshot.PriorityIssues)
                    {
                        <article class="sx-issue-card">

                            <div class="sx-issue-top">
                                <span class="sx-severity sx-severity-@issue.Severity.ToLowerInvariant()">
                                    @issue.Severity
                                </span>

                                <span class="sx-issue-status">
                                    @issue.Status
                                </span>
                            </div>

                            <h3>@issue.Title</h3>

                            <p>@issue.Description</p>

                            <div class="sx-issue-meta">
                                <span>REPORTED</span>
                                <strong>@issue.ReportedAtUtc.ToLocalTime()</strong>
                            </div>

                            @if (issue.Status.Equals(
                                "Open",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <button class="sx-button sx-button-danger"
                                        @onclick="() => ResolveIssueAsync(issue.Id)"
                                        disabled="@IsResolvingIssue">

                                    @(IsResolvingIssue
                                        ? "Resolving..."
                                        : "Resolve Incident")

                                </button>
                            }

                        </article>
                    }

                </div>
            }

        </section>
    }


    <!-- TRIAGE -->
    <section class="sx-section">

        <div class="sx-section-heading">
            <div>
                <span class="sx-section-kicker">04 / INVESTIGATION</span>
                <h2>Interactive Incident Triage</h2>
                <p>
                    Search, filter, and sort incidents to isolate the information
                    required during operational investigation.
                </p>
            </div>
        </div>

        <div class="sx-filter-panel">

            <div class="sx-field">
                <label for="issueSearch">Search incidents</label>

                <input id="issueSearch"
                       class="sx-input"
                       @bind="SearchText"
                       @bind:event="oninput"
                       placeholder="Search title or description..." />
            </div>

            <div class="sx-field">
                <label for="severityFilter">Severity</label>

                <select id="severityFilter"
                        class="sx-input"
                        @bind="SelectedSeverity">

                    <option value="All">All severities</option>
                    <option value="Critical">Critical</option>
                    <option value="Warning">Warning</option>
                    <option value="Info">Info</option>

                </select>
            </div>

            <div class="sx-field">
                <label for="statusFilter">Status</label>

                <select id="statusFilter"
                        class="sx-input"
                        @bind="SelectedStatus">

                    <option value="All">All statuses</option>
                    <option value="Open">Open</option>
                    <option value="Resolved">Resolved</option>

                </select>
            </div>

            <div class="sx-field">
                <label for="sortOrder">Sort by</label>

                <select id="sortOrder"
                        class="sx-input"
                        @bind="SelectedSort">

                    <option value="Priority">Highest priority</option>
                    <option value="Newest">Newest first</option>
                    <option value="Oldest">Oldest first</option>

                </select>
            </div>

        </div>

        <div class="sx-results-summary">
            <span class="sx-results-count">@FilteredIssues.Count()</span>
            <span>of @Issues.Count incidents displayed</span>
        </div>

    </section>


    <!-- REPORT ISSUE -->
    <section class="sx-section">

        <div class="sx-section-heading">
            <div>
                <span class="sx-section-kicker">05 / OPERATOR INPUT</span>
                <h2>Report an Issue</h2>
                <p>
                    Create an operational incident and immediately feed it
                    into the Smart-X engagement prioritisation engine.
                </p>
            </div>
        </div>

        <div class="sx-form-panel">

            <div class="sx-field sx-field-wide">
                <label for="issueTitle">Issue title</label>

                <input id="issueTitle"
                       class="sx-input"
                       @bind="NewIssueTitle"
                       placeholder="e.g. Soil moisture sensor reporting abnormal values" />
            </div>

            <div class="sx-field sx-field-wide">
                <label for="issueDescription">Description</label>

                <textarea id="issueDescription"
                          class="sx-input sx-textarea"
                          @bind="NewIssueDescription"
                          placeholder="Describe the observed behaviour, affected device, or operational concern"></textarea>
            </div>

            <div class="sx-field">
                <label for="issueSeverity">Severity</label>

                <select id="issueSeverity"
                        class="sx-input"
                        @bind="NewIssueSeverity">

                    <option value="Info">Information</option>
                    <option value="Warning">Warning</option>
                    <option value="Critical">Critical</option>

                </select>
            </div>

            <div class="sx-form-action">
                <button class="sx-button sx-button-primary"
                        @onclick="ReportIssueAsync"
                        disabled="@IsReportingIssue">

                    @(IsReportingIssue
                        ? "Reporting..."
                        : "Report Incident")

                </button>
            </div>

        </div>

    </section>


    <!-- LIVE BOARD -->
    <section class="sx-section">

        <div class="sx-section-heading">
            <div>
                <span class="sx-section-kicker">06 / LIVE OPERATIONS</span>
                <h2>Live Incident Board</h2>
                <p>
                    Current incident activity across the Smart-X environment.
                </p>
            </div>

            <div class="sx-live-label">
                <span></span>
                AUTO REFRESH / 10 SEC
            </div>
        </div>

        @if (IsLoadingIssues)
        {
            <div class="sx-loading-card">
                <div class="sx-spinner"></div>
                <div>
                    <strong>Refreshing incident activity</strong>
                    <span>Synchronising with the gateway...</span>
                </div>
            </div>
        }
        else if (!FilteredIssues.Any())
        {
            <div class="sx-empty-state">
                <div class="sx-empty-icon">—</div>
                <strong>No matching incidents</strong>
                <span>Try adjusting the current search or filters.</span>
            </div>
        }
        else
        {
            <div class="sx-issue-grid">

                @foreach (var issue in FilteredIssues)
                {
                    <article class="sx-issue-card">

                        <div class="sx-issue-top">
                            <span class="sx-severity sx-severity-@issue.Severity.ToLowerInvariant()">
                                @issue.Severity
                            </span>

                            <span class="sx-issue-status">
                                @issue.Status
                            </span>
                        </div>

                        <h3>@issue.Title</h3>

                        <p>@issue.Description</p>

                        <div class="sx-issue-meta">
                            <span>REPORTED</span>
                            <strong>@issue.ReportedAtUtc.ToLocalTime()</strong>
                        </div>

                        @if (issue.Status.Equals(
                            "Open",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <button class="sx-button sx-button-danger"
                                    @onclick="() => ResolveIssueAsync(issue.Id)"
                                    disabled="@IsResolvingIssue">

                                @(IsResolvingIssue
                                    ? "Resolving..."
                                    : "Resolve Incident")

                            </button>
                        }
                        else
                        {
                            <span class="sx-resolved-badge">
                                ✓ Resolved
                            </span>
                        }

                    </article>
                }

            </div>
        }

    </section>


    <!-- RECENT ACTIVITY -->
    @if (EngagementSnapshot is not null)
    {
        <section class="sx-section">

            <div class="sx-section-heading">
                <div>
                    <span class="sx-section-kicker">07 / AUDIT ACTIVITY</span>
                    <h2>Recent Engagement Activity</h2>
                    <p>
                        Recent system events provide operational context
                        for changing gateway conditions.
                    </p>
                </div>
            </div>

            @if (!EngagementSnapshot.RecentActivity.Any())
            {
                <div class="sx-empty-state">
                    <strong>No recent activity</strong>
                    <span>New engagement events will appear here.</span>
                </div>
            }
            else
            {
                <div class="sx-timeline">

                    @foreach (var issue in EngagementSnapshot.RecentActivity)
                    {
                        <article class="sx-timeline-item">

                            <div class="sx-timeline-marker"></div>

                            <div class="sx-timeline-content">

                                <div class="sx-timeline-heading">
                                    <h3>@issue.Title</h3>

                                    <span class="sx-severity sx-severity-@issue.Severity.ToLowerInvariant()">
                                        @issue.Severity
                                    </span>
                                </div>

                                <div class="sx-timeline-meta">
                                    <span>@issue.Status</span>
                                    <span>•</span>
                                    <span>@issue.ReportedAtUtc.ToLocalTime()</span>
                                </div>

                            </div>

                        </article>
                    }

                </div>
            }

        </section>
    }


    <!-- FEEDBACK -->
    @if (!string.IsNullOrWhiteSpace(DashboardMessage))
    {
        <div class="sx-feedback @(DashboardMessageCssClass == "connection-success" ? "success" : "error")"
             role="status"
             aria-live="polite">

            <span class="sx-feedback-icon">
                @(DashboardMessageCssClass == "connection-success" ? "✓" : "!")
            </span>

            <span>@DashboardMessage</span>

        </div>
    }


    <!-- ARCHITECTURE PILLARS -->
    <section class="sx-section sx-architecture-section">

        <div class="sx-section-heading">
            <div>
                <span class="sx-section-kicker">SMART-X / ARCHITECTURE</span>
                <h2>System Capabilities</h2>
                <p>
                    The Smart-X platform is being developed as a modular
                    IoT ecosystem across three architectural pillars.
                </p>
            </div>
        </div>

        <div class="sx-architecture-grid">

            <article class="sx-feature-card sx-feature-active">

                <div class="sx-feature-number">01</div>

                <div class="sx-feature-icon">SD</div>

                <span class="sx-feature-status">ACTIVE</span>

                <h3>Sensor Data Ingestion</h3>

                <p>
                    Register distributed sensors, submit telemetry,
                    validate incoming values, and monitor gateway activity.
                </p>

                <a href="/sensors"
                       class="sx-feature-link">
                    Open Sensor Management →
                </a>

            </article>


            <article class="sx-feature-card">

                <div class="sx-feature-number">02</div>

                <div class="sx-feature-icon">CS</div>

                <span class="sx-feature-status disabled">PART 2</span>

                <h3>Command Stream &amp; History</h3>

                <p>
                    Real-time command execution and historical command
                    management will extend the gateway in the next stage.
                </p>

                <span class="sx-feature-disabled">
                    Coming Later
                </span>

            </article>


            <article class="sx-feature-card">

                <div class="sx-feature-number">03</div>

                <div class="sx-feature-icon">NT</div>

                <span class="sx-feature-status disabled">FINAL PoE</span>

                <h3>Network Topology &amp; Mesh Routing</h3>

                <p>
                    Mesh topology visualisation and intelligent routing
                    capabilities will complete the Smart-X ecosystem.
                </p>

                <span class="sx-feature-disabled">
                    Coming Later
                </span>

            </article>

        </div>

    </section>

</div>


@code {

    private bool IsChecking;

    private bool GatewayOnline;

    private string GatewayStatus =
        "Gateway Status Unknown";

    private string? ConnectionMessage;

    private string ConnectionCssClass =
        string.Empty;

    private DashboardEngagementSnapshot? EngagementSnapshot;

    private List<UserIssue> Issues =
        new();

    private bool IsLoadingEngagement;

    private bool IsLoadingIssues;

    private bool IsReportingIssue;

    private bool IsResolvingIssue;

    private string? DashboardMessage;

    private string DashboardMessageCssClass =
        string.Empty;

    private string SearchText =
        string.Empty;

    private string SelectedSeverity =
        "All";

    private string SelectedStatus =
        "All";

    private string SelectedSort =
        "Priority";

    private string NewIssueTitle =
        string.Empty;

    private string NewIssueDescription =
        string.Empty;

    private string NewIssueSeverity =
        "Info";

    private PeriodicTimer? _refreshTimer;

    private CancellationTokenSource?
        _refreshCancellation;

    private IEnumerable<UserIssue> FilteredIssues
    {
        get
        {
            IEnumerable<UserIssue> result =
                Issues;

            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var search =
                    SearchText.Trim();

                result =
                    result.Where(x =>
                        x.Title.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase) ||
                        x.Description.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase));
            }

            if (!SelectedSeverity.Equals(
                    "All",
                    StringComparison.OrdinalIgnoreCase))
            {
                result =
                    result.Where(x =>
                        x.Severity.Equals(
                            SelectedSeverity,
                            StringComparison.OrdinalIgnoreCase));
            }

            if (!SelectedStatus.Equals(
                    "All",
                    StringComparison.OrdinalIgnoreCase))
            {
                result =
                    result.Where(x =>
                        x.Status.Equals(
                            SelectedStatus,
                            StringComparison.OrdinalIgnoreCase));
            }

            result =
                SelectedSort switch
                {
                    "Newest" =>
                        result.OrderByDescending(
                            x => x.ReportedAtUtc),

                    "Oldest" =>
                        result.OrderBy(
                            x => x.ReportedAtUtc),

                    _ =>
                        result
                            .OrderByDescending(
                                x => GetSeverityPriority(
                                    x.Severity))
                            .ThenByDescending(
                                x => x.Status.Equals(
                                    "Open",
                                    StringComparison.OrdinalIgnoreCase))
                            .ThenByDescending(
                                x => x.ReportedAtUtc)
                };

            return result;
        }
    }

    private static int GetSeverityPriority(
        string? severity)
    {
        return severity?.ToLowerInvariant() switch
        {
            "critical" => 3,
            "warning" => 2,
            "info" => 1,
            _ => 0
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await CheckGatewayAsync();

        StartLiveRefresh();
    }

    private async Task CheckGatewayAsync()
    {
        if (IsChecking)
        {
            return;
        }

        IsChecking = true;

        ConnectionMessage = null;
        ConnectionCssClass = string.Empty;
        GatewayStatus = "Checking Gateway...";

        try
        {
            var httpClient =
                HttpClientFactory.CreateClient(
                    "SmartXApi");

            using var response =
                await httpClient.GetAsync(
                    "",
                    HttpCompletionOption.ResponseHeadersRead);

            if (response.IsSuccessStatusCode)
            {
                GatewayOnline = true;

                GatewayStatus =
                    "Gateway Online";

                ConnectionMessage =
                    "Successfully connected to the Smart-X API.";

                ConnectionCssClass =
                    "connection-success";

                await LoadEngagementAsync();
            }
            else
            {
                GatewayOnline = false;

                GatewayStatus =
                    "Gateway Error";

                ConnectionMessage =
                    $"The Smart-X API returned HTTP {(int)response.StatusCode}.";

                ConnectionCssClass =
                    "connection-error";
            }
        }
        catch (TaskCanceledException)
        {
            GatewayOnline = false;

            GatewayStatus =
                "Gateway Timeout";

            ConnectionMessage =
                "The Smart-X API did not respond within the configured timeout.";

            ConnectionCssClass =
                "connection-error";
        }
        catch (HttpRequestException)
        {
            GatewayOnline = false;

            GatewayStatus =
                "Gateway Offline";

            ConnectionMessage =
                "Unable to connect to the Smart-X API.";

            ConnectionCssClass =
                "connection-error";
        }
        catch (Exception ex)
        {
            GatewayOnline = false;

            GatewayStatus =
                "Gateway Error";

            ConnectionMessage =
                $"Unexpected gateway error: {ex.Message}";

            ConnectionCssClass =
                "connection-error";
        }
        finally
        {
            IsChecking = false;
        }
    }

    private async Task LoadEngagementAsync()
    {
        if (IsLoadingEngagement)
        {
            return;
        }

        IsLoadingEngagement = true;

        try
        {
            var httpClient =
                HttpClientFactory.CreateClient(
                    "SmartXApi");

            var snapshot =
                await httpClient.GetFromJsonAsync<
                    DashboardEngagementSnapshot>(
                    "api/dashboard/engagement");

            if (snapshot is not null)
            {
                EngagementSnapshot =
                    snapshot;

                Issues =
                    snapshot.RecentActivity
                        .Concat(snapshot.PriorityIssues)
                        .GroupBy(x => x.Id)
                        .Select(x => x.First())
                        .OrderByDescending(
                            x => x.ReportedAtUtc)
                        .ToList();
            }

            DashboardMessage = null;
        }
        catch (HttpRequestException)
        {
            DashboardMessage =
                "Unable to refresh dashboard engagement data.";

            DashboardMessageCssClass =
                "connection-error";
        }
        catch (Exception ex)
        {
            DashboardMessage =
                $"Dashboard engagement error: {ex.Message}";

            DashboardMessageCssClass =
                "connection-error";
        }
        finally
        {
            IsLoadingEngagement = false;
        }
    }

    private async Task ReportIssueAsync()
    {
        DashboardMessage = null;

        if (string.IsNullOrWhiteSpace(NewIssueTitle))
        {
            DashboardMessage =
                "Issue title is required.";

            DashboardMessageCssClass =
                "connection-error";

            return;
        }

        if (string.IsNullOrWhiteSpace(
            NewIssueDescription))
        {
            DashboardMessage =
                "Issue description is required.";

            DashboardMessageCssClass =
                "connection-error";

            return;
        }

        IsReportingIssue = true;

        try
        {
            var httpClient =
                HttpClientFactory.CreateClient(
                    "SmartXApi");

            var issue = new UserIssue
            {
                Title =
                    NewIssueTitle.Trim(),

                Description =
                    NewIssueDescription.Trim(),

                Severity =
                    NewIssueSeverity,

                Status =
                    "Open"
            };

            var response =
                await httpClient.PostAsJsonAsync(
                    "api/dashboard/issues",
                    issue);

            if (response.IsSuccessStatusCode)
            {
                NewIssueTitle =
                    string.Empty;

                NewIssueDescription =
                    string.Empty;

                NewIssueSeverity =
                    "Info";

                DashboardMessage =
                    "Incident added to the live engagement system.";

                DashboardMessageCssClass =
                    "connection-success";

                await LoadEngagementAsync();
            }
            else
            {
                DashboardMessage =
                    $"Issue could not be reported. HTTP {(int)response.StatusCode}.";

                DashboardMessageCssClass =
                    "connection-error";
            }
        }
        catch (HttpRequestException)
        {
            DashboardMessage =
                "Unable to connect to the Smart-X API.";

            DashboardMessageCssClass =
                "connection-error";
        }
        finally
        {
            IsReportingIssue = false;
        }
    }

    private async Task ResolveIssueAsync(
        Guid issueId)
    {
        if (IsResolvingIssue)
        {
            return;
        }

        IsResolvingIssue = true;

        DashboardMessage = null;

        try
        {
            var httpClient =
                HttpClientFactory.CreateClient(
                    "SmartXApi");

            var response =
                await httpClient.PutAsync(
                    $"api/dashboard/issues/{issueId}/resolve",
                    null);

            if (response.IsSuccessStatusCode)
            {
                DashboardMessage =
                    "Incident resolved and engagement priorities updated.";

                DashboardMessageCssClass =
                    "connection-success";

                await LoadEngagementAsync();
            }
            else
            {
                DashboardMessage =
                    $"Issue could not be resolved. HTTP {(int)response.StatusCode}.";

                DashboardMessageCssClass =
                    "connection-error";
            }
        }
        catch (HttpRequestException)
        {
            DashboardMessage =
                "Unable to connect to the Smart-X API.";

            DashboardMessageCssClass =
                "connection-error";
        }
        finally
        {
            IsResolvingIssue = false;
        }
    }

    private void StartLiveRefresh()
    {
        _refreshCancellation =
            new CancellationTokenSource();

        _refreshTimer =
            new PeriodicTimer(
                TimeSpan.FromSeconds(10));

        _ = RefreshLoopAsync(
            _refreshCancellation.Token);
    }

    private async Task RefreshLoopAsync(
        CancellationToken cancellationToken)
    {
        if (_refreshTimer is null)
        {
            return;
        }

        try
        {
            while (await _refreshTimer
                .WaitForNextTickAsync(
                    cancellationToken))
            {
                if (!GatewayOnline)
                {
                    continue;
                }

                await InvokeAsync(
                    async () =>
                    {
                        await LoadEngagementAsync();

                        StateHasChanged();
                    });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public void Dispose()
    {
        try
        {
            _refreshCancellation?.Cancel();
        }
        catch
        {
        }

        _refreshTimer?.Dispose();

        _refreshCancellation?.Dispose();
    }
}
