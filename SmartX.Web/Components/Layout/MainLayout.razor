@inherits LayoutComponentBase

<style>


    :root {
        --sx-navy-950: #071426;
        --sx-navy-900: #0a1b31;
        --sx-navy-800: #102844;
        --sx-navy-700: #16375d;
        --sx-blue-600: #1769aa;
        --sx-blue-500: #2386d9;
        --sx-blue-400: #4da3e8;
        --sx-blue-100: #e8f3fc;
        --sx-grey-950: #17202b;
        --sx-grey-800: #344252;
        --sx-grey-600: #627083;
        --sx-grey-500: #7d8b9a;
        --sx-grey-300: #cbd4de;
        --sx-grey-200: #e2e8ee;
        --sx-grey-100: #f1f4f7;
        --sx-white: #ffffff;
        --sx-success: #16835b;
        --sx-warning: #c27a12;
        --sx-danger: #c43d4b;
        --sx-shadow: 0 12px 32px rgba(7, 20, 38, .08);
        --sx-radius: 14px;
    }

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        background: #f4f7fa;
        color: var(--sx-grey-950);
        font-family:
            Inter,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Arial,
            sans-serif;
    }

    button,
    input,
    select,
    textarea {
        font: inherit;
    }

    a {
        color: inherit;
    }

    .app-shell {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background:
            linear-gradient(
                180deg,
                #f7f9fb 0%,
                #f1f4f7 100%
            );
    }

    .app-topbar {
        position: sticky;
        top: 0;
        z-index: 100;
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 42px;
        background: rgba(7, 20, 38, .97);
        border-bottom: 1px solid rgba(255,255,255,.08);
        box-shadow: 0 5px 20px rgba(0,0,0,.12);
    }

    .app-brand {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .app-brand-mark {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(77,163,232,.55);
        border-radius: 9px;
        background: linear-gradient(
            145deg,
            #1769aa,
            #0d416f
        );
        color: white;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: .08em;
        box-shadow: 0 5px 16px rgba(35,134,217,.2);
    }

    .app-brand-name {
        display: block;
        color: white;
        font-size: 15px;
        line-height: 1;
        font-weight: 800;
        letter-spacing: .16em;
    }

    .app-brand-subtitle {
        display: block;
        margin-top: 5px;
        color: #9fb0c2;
        font-size: 10px;
        line-height: 1;
        font-weight: 600;
        letter-spacing: .14em;
        text-transform: uppercase;
    }

    .app-topbar-status {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #b7c5d3;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .04em;
    }

    .app-live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #37c98a;
        box-shadow: 0 0 0 4px rgba(55,201,138,.12);
    }

    .app-main {
        flex: 1;
        width: 100%;
    }

    .app-footer {
        display: flex;
        justify-content: center;
        gap: 12px;
        padding: 28px 24px;
        border-top: 1px solid var(--sx-grey-200);
        background: var(--sx-white);
        color: var(--sx-grey-600);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
    }


    .sx-page {
        width: min(1380px, calc(100% - 48px));
        margin: 0 auto;
        padding: 42px 0 80px;
    }

    .sx-hero {
        position: relative;
        min-height: 330px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 52px 64px;
        margin-bottom: 28px;
        border-radius: 20px;
        background:
            radial-gradient(
                circle at 85% 50%,
                rgba(35,134,217,.22),
                transparent 28%
            ),
            linear-gradient(
                120deg,
                #071426 0%,
                #0d2745 55%,
                #12385e 100%
            );
        box-shadow: 0 18px 45px rgba(7,20,38,.16);
    }

    .sx-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: .25;
        background-image:
            linear-gradient(
                rgba(255,255,255,.035) 1px,
                transparent 1px
            ),
            linear-gradient(
                90deg,
                rgba(255,255,255,.035) 1px,
                transparent 1px
            );
        background-size: 34px 34px;
    }

    .sx-hero-content {
        position: relative;
        z-index: 2;
        max-width: 760px;
    }

    .sx-eyebrow {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 17px;
        color: #77b9e8;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .16em;
    }

    .sx-eyebrow-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #4da3e8;
        box-shadow: 0 0 0 5px rgba(77,163,232,.12);
    }

    .sx-hero h1 {
        margin: 0;
        color: white;
        font-size: clamp(38px, 5vw, 62px);
        line-height: .98;
        font-weight: 800;
        letter-spacing: -.045em;
    }

    .sx-hero h1 span {
        display: block;
        color: #5daeea;
    }

    .sx-hero-description {
        max-width: 650px;
        margin: 22px 0 25px;
        color: #bdcddd;
        font-size: 15px;
        line-height: 1.75;
    }

    .sx-hero-meta {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    .sx-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 13px;
        border: 1px solid rgba(255,255,255,.13);
        border-radius: 999px;
        background: rgba(255,255,255,.07);
        color: #e3edf6;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .07em;
    }

    .sx-status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .sx-status-dot.online {
        background: #37c98a;
        box-shadow: 0 0 0 4px rgba(55,201,138,.12);
    }

    .sx-status-dot.offline {
        background: #db4d5b;
        box-shadow: 0 0 0 4px rgba(219,77,91,.12);
    }

    .sx-divider {
        width: 1px;
        height: 18px;
        background: rgba(255,255,255,.16);
    }

    .sx-meta-text {
        color: #91a5b8;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .05em;
    }


    .sx-hero-visual {
        position: relative;
        width: 270px;
        height: 270px;
        flex: 0 0 270px;
    }

    .sx-core {
        position: absolute;
        inset: 50% auto auto 50%;
        width: 78px;
        height: 78px;
        transform: translate(-50%, -50%);
        display: grid;
        place-items: center;
        border: 1px solid rgba(93,174,234,.7);
        border-radius: 50%;
        background: rgba(23,105,170,.35);
        box-shadow:
            0 0 0 10px rgba(35,134,217,.05),
            0 0 45px rgba(35,134,217,.25);
        color: white;
        font-size: 18px;
        font-weight: 800;
    }

    .sx-orbit {
        position: absolute;
        inset: 50% auto auto 50%;
        border: 1px solid rgba(93,174,234,.2);
        border-radius: 50%;
        transform: translate(-50%, -50%);
    }

    .sx-orbit-one {
        width: 160px;
        height: 160px;
    }

    .sx-orbit-two {
        width: 245px;
        height: 245px;
    }

    .sx-signal {
        position: absolute;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #4da3e8;
        box-shadow: 0 0 15px #4da3e8;
    }

    .sx-signal-one {
        top: 25px;
        right: 45px;
    }

    .sx-signal-two {
        bottom: 38px;
        left: 22px;
    }

    .sx-signal-three {
        right: 5px;
        bottom: 95px;
    }


    .sx-section,
    .sx-control-panel {
        margin-bottom: 28px;
        padding: 32px;
        border: 1px solid var(--sx-grey-200);
        border-radius: var(--sx-radius);
        background: white;
        box-shadow: var(--sx-shadow);
    }

    .sx-section-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 25px;
        margin-bottom: 26px;
    }

    .sx-section-kicker,
    .sx-card-kicker {
        display: block;
        margin-bottom: 7px;
        color: var(--sx-blue-600);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .14em;
    }

    .sx-section-heading h2 {
        margin: 0;
        color: var(--sx-navy-900);
        font-size: 25px;
        line-height: 1.2;
        font-weight: 750;
        letter-spacing: -.025em;
    }

    .sx-section-heading p {
        max-width: 720px;
        margin: 8px 0 0;
        color: var(--sx-grey-600);
        font-size: 13px;
        line-height: 1.65;
    }


    .sx-button {
        min-height: 43px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 0 17px;
        border: 1px solid transparent;
        border-radius: 8px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 750;
        letter-spacing: .02em;
        transition:
            transform .15s ease,
            box-shadow .15s ease,
            background .15s ease;
    }

    .sx-button:hover:not(:disabled) {
        transform: translateY(-1px);
    }

    .sx-button:disabled {
        opacity: .55;
        cursor: not-allowed;
    }

    .sx-button-primary {
        background: var(--sx-blue-600);
        color: white;
        box-shadow: 0 6px 15px rgba(23,105,170,.18);
    }

    .sx-button-primary:hover:not(:disabled) {
        background: #125c94;
        box-shadow: 0 9px 20px rgba(23,105,170,.24);
    }

    .sx-button-secondary {
        background: white;
        border-color: var(--sx-grey-300);
        color: var(--sx-grey-800);
    }

    .sx-button-danger {
        background: #fff;
        border-color: #e5b5ba;
        color: #a72d3b;
    }

    .sx-button-danger:hover:not(:disabled) {
        background: #fff5f6;
    }

    .sx-button-icon {
        font-size: 17px;
        line-height: 1;
    }


    .sx-feedback {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 18px;
        padding: 13px 15px;
        border: 1px solid;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 600;
    }

    .sx-feedback.success {
        border-color: #b9dfcf;
        background: #f1faf6;
        color: #146b4c;
    }

    .sx-feedback.error {
        border-color: #edc3c7;
        background: #fff5f6;
        color: #a32f3d;
    }

    .sx-feedback-icon {
        width: 24px;
        height: 24px;
        flex: 0 0 24px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: currentColor;
        color: white;
        font-size: 11px;
        font-weight: 800;
    }


    .sx-live-label {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 7px 10px;
        border: 1px solid var(--sx-grey-200);
        border-radius: 999px;
        color: var(--sx-grey-600);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .12em;
        white-space: nowrap;
    }

    .sx-live-label span {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--sx-success);
        box-shadow: 0 0 0 4px rgba(22,131,91,.1);
    }

    .sx-attention-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 23px;
        margin-bottom: 16px;
        border: 1px solid #d5e4f0;
        border-left: 4px solid var(--sx-blue-600);
        border-radius: 10px;
        background:
            linear-gradient(
                100deg,
                #f5faff,
                #ffffff
            );
    }

    .sx-attention-value {
        display: block;
        margin-top: 4px;
        color: var(--sx-navy-900);
        font-size: 24px;
    }

    .sx-card-subtext {
        display: block;
        margin-top: 6px;
        color: var(--sx-grey-500);
        font-size: 11px;
    }

    .sx-attention-indicator {
        width: 54px;
        height: 54px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--sx-blue-100);
    }

    .sx-attention-indicator span {
        width: 17px;
        height: 17px;
        border-radius: 50%;
        background: var(--sx-blue-500);
        box-shadow: 0 0 0 7px rgba(35,134,217,.1);
    }


    .sx-kpi-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 12px;
    }

    .sx-kpi-card {
        min-height: 125px;
        padding: 18px;
        border: 1px solid var(--sx-grey-200);
        border-radius: 10px;
        background: #fbfcfd;
    }

    .sx-kpi-label {
        display: block;
        color: var(--sx-grey-500);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .1em;
    }

    .sx-kpi-card strong {
        display: block;
        margin: 10px 0 5px;
        color: var(--sx-navy-900);
        font-size: 30px;
        line-height: 1;
    }

    .sx-kpi-description {
        color: var(--sx-grey-600);
        font-size: 10px;
        line-height: 1.4;
    }

    .sx-kpi-critical {
        border-top: 3px solid var(--sx-danger);
    }

    .sx-kpi-warning {
        border-top: 3px solid var(--sx-warning);
    }

    .sx-kpi-resolved {
        border-top: 3px solid var(--sx-success);
    }

    .sx-alert {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-top: 16px;
        padding: 15px 17px;
        border: 1px solid;
        border-radius: 10px;
    }

    .sx-alert-icon {
        width: 32px;
        height: 32px;
        flex: 0 0 32px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        font-size: 12px;
        font-weight: 800;
    }

    .sx-alert strong {
        font-size: 12px;
    }

    .sx-alert p {
        margin: 3px 0 0;
        font-size: 11px;
    }

    .sx-alert-critical {
        border-color: #efc4c8;
        background: #fff6f7;
        color: #9f2937;
    }

    .sx-alert-critical .sx-alert-icon {
        background: #c43d4b;
        color: white;
    }

    .sx-alert-warning {
        border-color: #ecd8b8;
        background: #fffaf1;
        color: #94600e;
    }

    .sx-alert-warning .sx-alert-icon {
        background: #c27a12;
        color: white;
    }

    .sx-alert-info {
        border-color: #c7ddec;
        background: #f4f9fd;
        color: #175d91;
    }

    .sx-alert-info .sx-alert-icon {
        background: #2386d9;
        color: white;
    }

    .sx-alert-success {
        border-color: #c5e1d5;
        background: #f3faf7;
        color: #176b4d;
    }

    .sx-alert-success .sx-alert-icon {
        background: #16835b;
        color: white;
    }

    .sx-issue-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
    }

    .sx-issue-card {
        padding: 20px;
        border: 1px solid var(--sx-grey-200);
        border-radius: 11px;
        background: white;
        transition:
            transform .15s ease,
            box-shadow .15s ease;
    }

    .sx-issue-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(7,20,38,.08);
    }

    .sx-issue-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 16px;
    }

    .sx-severity,
    .sx-issue-status {
        display: inline-flex;
        align-items: center;
        min-height: 23px;
        padding: 0 8px;
        border-radius: 5px;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .sx-severity-critical {
        background: #fff0f2;
        color: #b12f3e;
    }

    .sx-severity-warning {
        background: #fff7e9;
        color: #9a650f;
    }

    .sx-severity-info {
        background: #edf6fd;
        color: #17679f;
    }

    .sx-issue-status {
        background: var(--sx-grey-100);
        color: var(--sx-grey-600);
    }

    .sx-issue-card h3 {
        margin: 0 0 8px;
        color: var(--sx-navy-900);
        font-size: 15px;
    }

    .sx-issue-card p {
        min-height: 44px;
        margin: 0 0 18px;
        color: var(--sx-grey-600);
        font-size: 12px;
        line-height: 1.6;
    }

    .sx-issue-meta {
        padding-top: 13px;
        margin-bottom: 15px;
        border-top: 1px solid var(--sx-grey-200);
    }

    .sx-issue-meta span {
        display: block;
        color: var(--sx-grey-500);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .1em;
    }

    .sx-issue-meta strong {
        display: block;
        margin-top: 4px;
        color: var(--sx-grey-800);
        font-size: 10px;
    }

    .sx-resolved-badge {
        display: inline-flex;
        padding: 7px 10px;
        border-radius: 6px;
        background: #edf8f3;
        color: #16835b;
        font-size: 10px;
        font-weight: 750;
    }

    .sx-filter-panel,
    .sx-form-panel {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        padding: 22px;
        border: 1px solid var(--sx-grey-200);
        border-radius: 11px;
        background: #fafcfd;
    }

    .sx-field {
        min-width: 0;
    }

    .sx-field-wide {
        grid-column: span 2;
    }

    .sx-field label {
        display: block;
        margin-bottom: 7px;
        color: var(--sx-grey-800);
        font-size: 11px;
        font-weight: 750;
    }

    .required {
        color: var(--sx-danger);
    }

    .sx-input {
        width: 100%;
        min-height: 42px;
        padding: 9px 11px;
        border: 1px solid var(--sx-grey-300);
        border-radius: 7px;
        outline: none;
        background: white;
        color: var(--sx-grey-950);
        font-size: 12px;
        transition:
            border-color .15s ease,
            box-shadow .15s ease;
    }

    .sx-input:focus {
        border-color: var(--sx-blue-500);
        box-shadow: 0 0 0 3px rgba(35,134,217,.1);
    }

    .sx-input::placeholder {
        color: #a2aeba;
    }

    .sx-textarea {
        min-height: 105px;
        resize: vertical;
        line-height: 1.5;
    }

    .sx-field-help {
        display: block;
        margin-top: 6px;
        color: var(--sx-grey-500);
        font-size: 10px;
        line-height: 1.4;
    }

    .validation-message {
        display: block;
        margin-top: 5px;
        color: var(--sx-danger);
        font-size: 10px;
        font-weight: 600;
    }

    .sx-validation-panel:empty {
        display: none;
    }

    .sx-validation-panel ul {
        margin: 0 0 18px;
        padding: 12px 16px;
        border: 1px solid #efc5ca;
        border-radius: 8px;
        background: #fff6f7;
        color: #a32f3d;
        font-size: 11px;
    }

    .sx-form-section-label {
        grid-column: 1 / -1;
        padding-bottom: 9px;
        border-bottom: 1px solid var(--sx-grey-200);
        color: var(--sx-blue-600);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .14em;
    }

    .sx-form-actions {
        grid-column: 1 / -1;
        display: flex;
        gap: 10px;
        padding-top: 8px;
        border-top: 1px solid var(--sx-grey-200);
    }

    .sx-form-action {
        display: flex;
        align-items: flex-end;
    }

    .sx-active-toggle {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 13px;
        border: 1px solid #d8e5ef;
        border-radius: 8px;
        background: #f5faff;
    }

    .sx-active-toggle input {
        width: 17px;
        height: 17px;
        accent-color: var(--sx-blue-600);
    }

    .sx-active-toggle label {
        display: flex;
        flex-direction: column;
        gap: 3px;
        cursor: pointer;
    }

    .sx-active-toggle strong {
        color: var(--sx-navy-900);
        font-size: 11px;
    }

    .sx-active-toggle span {
        color: var(--sx-grey-600);
        font-size: 10px;
    }

    .sx-results-summary {
        display: flex;
        align-items: baseline;
        gap: 6px;
        margin-top: 16px;
        color: var(--sx-grey-600);
        font-size: 11px;
    }

    .sx-results-count {
        color: var(--sx-navy-900);
        font-size: 18px;
        font-weight: 800;
    }

    .sx-empty-state {
        min-height: 130px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 25px;
        border: 1px dashed var(--sx-grey-300);
